# Vorlage für die Umgebungsvariablen (gehört NICHT ins Repo)
#
# Unter Plesk werden diese Werte im Node.js-Panel der Subdomain gepflegt
# (Websites & Domains → thecircle.planyvo.com → Node.js → Custom environment
# variables), nicht in einer Datei. Auf einem selbstverwalteten Server liegt
# die Datei als /opt/thecircle/.env (chmod 600).

# Port
# ACHTUNG: Unter Plesk NICHT setzen – Plesk vergibt den Port selbst und reicht
# ihn als PORT durch. Nur auf einem selbstverwalteten Server eintragen.
#PORT=8080

# Basis-URL für die persönlichen Links und die Stripe-Rückkehr
PUBLIC_URL=https://thecircle.planyvo.com

# Stripe (erst Test-, später Live-Schlüssel)
STRIPE_SECRET_KEY=sk_test_hier_einsetzen
STRIPE_WEBHOOK_SECRET=whsec_hier_einsetzen

# Ticketpreis in Cent
TICKET_PRICE=10000

# Wie viele Bezahlgäste höchstens zusagen dürfen. Der Saal ist endlich, und
# die Plätze der Partner- und Ehrengäste sind vergeben, bevor der erste
# Bezahlgast antwortet. Wer nach dem Deckel zusagt, landet auf der
# Warteliste statt auf der Bezahlseite. Belegt ist ein Platz mit der
# ZUSAGE, nicht erst mit der Zahlung.
TICKET_LIMIT=50

# Rechnung statt blossem Zahlungsbeleg (STRIPE_RECHNUNG=1).
# Stripe schickt nach jeder Zahlung von sich aus einen Beleg - der zeigt nur,
# dass Geld geflossen ist. Wer die 100 Euro absetzen will, braucht eine
# Rechnung mit Nummer, Aussteller und Steuerausweis; die erzeugt dieser
# Schalter (Stripe "invoice_creation").
# ACHTUNG: Auf der Rechnung stehen Firmierung, Anschrift und Steuerausweis
# aus dem Stripe-Konto, und der Umsatzsteuerausweis kommt aus den dort
# hinterlegten Steuersaetzen. Erst einschalten, wenn geklaert ist, wer
# Rechnungssteller ist und ob auf den Beitrag Umsatzsteuer anfaellt.
#STRIPE_RECHNUNG=1

# --- Eigene Rechnung aus unserer Mail (statt über Stripe) ---
# DIE ANGABEN STEHEN IN deploy/rechnung.json - nichts davon muss hier
# eingetragen werden. Die Variablen unten überschreiben einzelne Werte
# nur, falls ein Server andere braucht als das Repo.
# Gebraucht, weil das Stripe-Konto auf eine andere Gesellschaft läuft als die,
# die Rechnungssteller sein soll - und die Kontodaten zu ändern hieße, die
# Stripe-Prüfung erneut auszulösen.
# 100 € sind eine Kleinbetragsrechnung nach § 33 UStDV (bis 250 € brutto):
# Empfängeranschrift und fortlaufende Nummer sind nicht vorgeschrieben.
# Ausgestellt wird von der Agentur, das Geld liegt auf dem Konto der
# Veranstaltung. Beides steht getrennt auf dem Beleg: oben der
# Rechnungssteller, unten im Fuß der Zahlungsempfänger. Marke und Farben
# sind die von THE CIRCLE - wer die Rechnung stellt, sagt der Text.
#RECHNUNG_AKTIV=1
#RECHNUNG_FIRMA=Ihre Markenwerkstatt
# Zeilen mit | trennen
#RECHNUNG_ANSCHRIFT=Gertrudenstraße 9|50667 Köln
#RECHNUNG_STEUER=USt-IdNr. DE 281 844 556
# 19 = Umsatzsteuer ausgewiesen, 0 = keine (dann Grund in RECHNUNG_HINWEIS!)
#RECHNUNG_USTSATZ=19
#RECHNUNG_HINWEIS=Gemäß § 19 UStG wird keine Umsatzsteuer berechnet.
#RECHNUNG_PRAEFIX=CIRCLE-2026-
#RECHNUNG_KONTAKT=info@ihre-markenwerkstatt.de
# Zahlungsempfänger und Bankverbindung - stehen im Fuß als Angabe, nicht als
# Aufforderung: über Stripe ist beim Versand der Rechnung längst bezahlt.
#RECHNUNG_KONTOINHABER=THE CIRCLE
#RECHNUNG_BANK=Kreissparkasse Köln|IBAN DE92 3705 0299 0000 8089 01|BIC COKSDE33XXX

# Schützt /api/admin/* und damit den Monitor.
# Ein Zugang je Person – so lässt sich ein einzelner Zugang entziehen, ohne
# allen anderen den Link zu ändern. Format: name:token,name:token
# Token erzeugen mit:  openssl rand -hex 16
ADMIN_TOKENS=anne:hier_token_1,desi:hier_token_2,nicole:hier_token_3

# Alternative für einen einzigen gemeinsamen Zugang (wird zusätzlich akzeptiert).
# Wenn ADMIN_TOKENS gesetzt ist, braucht es das hier nicht.
#ADMIN_TOKEN=hier_ein_langes_geheimnis

# --- Mailversand über Lettermint ---
# Der Schlüssel wird in Lettermint unter "API tokens" erzeugt und dort nur
# EINMAL angezeigt. Taucht er je in einem Screenshot, einer Mail oder einem
# Commit auf: in Lettermint löschen und einen neuen erzeugen.
LETTERMINT_TOKEN=hier_einsetzen

# Absender. Die Domain muss in Lettermint verifiziert sein.
MAIL_FROM=THE CIRCLE <hello@the-circle-cologne.de>

# Wohin Antworten der Gäste gehen sollen (leer = an den Absender).
MAIL_REPLY_TO=

# "Signing secret" aus den Webhook-Einstellungen. Ohne diesen Wert weist der
# Server jeden Lettermint-Webhook ab - sonst könnte jeder Fremde
# "zugestellt"/"geöffnet" in unser Register schreiben.
LETTERMINT_WEBHOOK_SECRET=hier_einsetzen

# Optional: benannte Route in Lettermint (leer = Standardroute).
#MAIL_ROUTE=

# Ziel des Buttons in Welle 0 (Save the Date) - die Homepage, nicht die App.
#WEBSITE_URL=https://www.the-circle-cologne.de

# Rückmeldefrist in den Einladungen ("Wir bitten um Rückmeldung bis zum …")
# steht NICHT mehr hier, sondern fest im Code (RSVP_DEADLINE in
# server/circle-server.js). RSVP_DEADLINE und RSVP_DEADLINE_TICKET werden
# nicht mehr gelesen – wer sie hier noch stehen hat, kann sie löschen.
# Grund: eine überschriebene Frist sieht man der fertigen Mail nicht an. Ein
# Leerzeichen im Variablennamen ließ sie wirkungslos werden, und später
# schlug ein vergessener alter Wert den frisch ausgerollten Code – der Gast
# hätte ein Datum von gestern gelesen. Verschiebt sich die Frist, ist das
# eine Codeänderung mit Diff und Prüfung.

# --- Datenschutz / Impressum (Seiten /datenschutz und /impressum) ---
# Verantwortlicher im Sinne der DSGVO, Zeilen mit | trennen. Solange das
# fehlt, steht auf beiden Seiten sichtbar "noch einzutragen".
#VERANTWORTLICH=Firma GmbH|Musterstraße 1|50667 Köln|Vertreten durch: Vorname Nachname
#DATENSCHUTZ_KONTAKT=hello@the-circle-cologne.de
# Runde, in die neue Gaeste-Importe fallen (Gaestebuch ist je Runde getrennt)
#RUNDE=no1
# Web Push: einmal erzeugen, nie wechseln
#   node -e "console.log(require('./server/webpush').schluesselErzeugen())"
#VAPID_PUBLIC=
#VAPID_PRIVATE=
#VAPID_SUBJECT=mailto:hello@the-circle-cologne.de
# Zeitzone des Prozesses (die App-frei-Fenster rechnen ohnehin in Europe/Berlin)
#TZ=Europe/Berlin
