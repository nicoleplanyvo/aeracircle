# Vorlage für die Umgebungsvariablen der STAND-Anwendung
# (showoff.planyvo.com - Websites & Domains → Node.js → Custom environment
# variables). Gehört wie die andere Vorlage nicht ausgefüllt ins Repo.
#
# Das ist eine ZWEITE Anwendung aus demselben Code, in einem EIGENEN
# Verzeichnis. Sie hat ihren eigenen Zustand (server/live-state.json liegt
# neben ihrer eigenen Kopie) und darf nie im Verzeichnis des Abends laufen -
# zwei Node-Prozesse im selben Ordner überschreiben sich gegenseitig.

# Schaltet auf den Stand-Betrieb: Es antwortet nur der Touchscreen und seine
# Schnittstellen. Gäste-App, Monitor, Wand, Einlass, Stripe und die Wellen
# sind hier gar nicht erst erreichbar.
APP_MODE=stand

# Die eigene Adresse. PORT unter Plesk NICHT setzen.
PUBLIC_URL=https://showoff.planyvo.com

# Der Anlass, an dem der Stand gerade steht. Leer lassen, sobald er woanders
# steht - dann nennt der Stand keinen Anlass, und weder Startbild noch Mail
# behaupten etwas Falsches.
STAND_ANLASS=THE CIRCLE No1

# Landet als ?stand=… im QR-Code auf dem Dankebild - damit auf planyvo.com
# sichtbar ist, von welchem Stand der Besuch kam.
STAND_QUELLE=showoff

# Vorbelegte Stadt im Formular (die häufigste Antwort spart zwei Griffe).
STAND_STADT=Köln

# Absender der Entwurfsmail. Der Gast hat mit planyvo gesprochen, nicht mit
# dem Gastgeber des Abends - so soll die Mail auch ankommen.
# ACHTUNG: Die Domain muss in Lettermint eingerichtet sein, sonst lehnt der
# Versand ab. Einmal prüfen, bevor jemand am Stand steht:
#   curl -X POST "https://showoff.planyvo.com/api/admin/stand-probe?key=…&an=…"
STAND_MAIL_FROM=planyvo <hello@planyvo.com>

# Optional, falls Route oder Antwortadresse abweichen sollen.
#STAND_MAIL_ROUTE=
#STAND_MAIL_REPLY_TO=

# Optional: die Zeile über der Überschrift. Ohne Angabe aus STAND_ANLASS
# abgeleitet.
#STAND_KICKER=Start-up des Abends · THE CIRCLE No1

# Versand der Entwurfsmail.
LETTERMINT_TOKEN=hier_einsetzen

# Derselbe Eintrag wie beim Abend - dann holt der CSV-Knopf im Monitor die
# Entwürfe von hier, ohne zweiten Schlüssel.
ADMIN_TOKENS=nicole:hier_token

# Optional: legt jeden Entwurf sofort als DRAFT im planyvo-Dashboard an.
PLANYVO_API_KEY=

# NICHT setzen: STRIPE_*, LETTERMINT_WEBHOOK_SECRET, VAPID_*, TICKET_*.
# Der Stand braucht nichts davon - und was nicht da ist, kann auch nicht
# verloren gehen.
